<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SFSU_VeteranServices_Tracker.AiCheckInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AI Check-In"
    BackgroundColor="#1E1E1E">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="20">

        <!-- Page Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8"
            Margin="0,10,0,20">

            <Label
                Text="Veterans Corner AI Check-In"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#B69CFF"
                HorizontalOptions="Center" />

            <Label
                Text="Use the assistant below to complete your check-in."
                FontSize="14"
                TextColor="#CCCCCC"
                HorizontalOptions="Center" />

        </VerticalStackLayout>


        <!-- Conversation Area -->
        <Border
            Grid.Row="1"
            Stroke="#444444"
            StrokeThickness="1"
            BackgroundColor="#252525"
            Padding="15">

            <ScrollView
                x:Name="ChatScrollView">

                <VerticalStackLayout
                    x:Name="ChatMessagesLayout"
                    Spacing="15">

                    <!-- Initial AI Message -->
                    <HorizontalStackLayout
                        HorizontalOptions="Start">

                        <Border
                            BackgroundColor="#3A3A3A"
                            Padding="12"
                            MaximumWidthRequest="600">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="AI Assistant"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#B69CFF" />

                                <Label
                                    Text="Hello! Welcome to the Veterans Corner. How can I help you today?"
                                    FontSize="16"
                                    TextColor="White"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </Border>


        <!-- Message Input -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            Margin="0,15,0,0">

            <Entry
                x:Name="MessageEntry"
                Grid.Column="0"
                Placeholder="Type your message..."
                PlaceholderColor="#777777"
                TextColor="White"
                BackgroundColor="#2A2A2A"
                HeightRequest="50"
                ReturnType="Send" />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Text="Send"
                BackgroundColor="#A58AEF"
                TextColor="#1E1E1E"
                FontAttributes="Bold"
                Padding="24,10"
                HeightRequest="50"
                Clicked="OnSendClicked" />

        </Grid>

    </Grid>

</ContentPage>